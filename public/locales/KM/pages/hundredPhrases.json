      "phrases": [
        "Byen sir",
        "Wi",
        "Non",
        "Mo pa kone",
        "Sil te ple",
        "Mersi",
        "Pa dekwa",
        "Pena problem",
        "Ok, tu korek"
      ]
    },
    {
      "title": "Prezansazyon",
      "img": "/images/hundredPhrases/introducing.webp",
      "alt": "Introducing Image",
      "phrases": [
        "Mo prezant twa/ ou Arletta",
        "Mo invit twa rankont mo bann kamarad",
        "Byen kontan",
        "Enn plezir",
        "To finn deza zwenn Maria?",
        "Ki manyer",
        "Mo apel Anzelo",
        "Kuma to apele?",
        "Mo apel Anzelo"
      ]
    },
    {
      "title": "Koz lor to pei dorizinn",
      "img": "/images/hundredPhrases/talking about country.webp",
      "alt": "Talking about Country Image",
      "phrases": [
        "Ki pei to sorti?",
        "Mo pei apel Peru( Lezip/ Moris/ Brezil eksetera.",
        "To enn Sinwa?",
        "Wi!",
        "Non, Mo enn Peruvien/ Ezipsyen/ MOrisyen/ Brezilyen/ eksetera."
      ]
    },
    {
      "title": "Dir kikenn komye tan to pe reste",
      "phrases": [
        "Komye tan to pe reste?",
        "De semen",
        "Zis detrwa zur",
        "Enn mwa",
        "De twa zur Selman"
      ]
    },
    {
      "title": "Exprim to satisfaksyon a enn landrwa",
      "phrases": [
        "Kuma ou truv sa plas la?",
        "Mo kontan li",
        "Li vreman zoli",
        "Byen, pa boukou"
      ]
    },
    {
      "title": "Koz lor travay",
      "img": "/images/hundredPhrases/talking_about_work.webp",
      "alt": "Talking about Work Image",
      "phrases": [
        "Ki to fer dan lavi?",
        "Mo enn profeser( inzenyer/ sarpantye/ fiter/dokter( eksetera",
        "Mo travay avek kompwuter",
        "Mo okip mo de zanfan",
        "Ou kontan ou travay?",
        "Wi, mo kontan",
        "Pa otan/ pa vreman …….li boring",
        "Li plito korek pu le moman"
      ]
    },
    {
      "title": "Koz lor lekol",
      "img": "/images/hundredPhrases/talking_about_school.webp",
      "alt": "Talking about School Image",
      "phrases": [
        "To enn etidya?",
        "Wi",
        "Ki to pe aprann?",
        "Mo pe aprann bann katastrof natirel/ la lwa/ Medsinn",
        "Kot to lekol ete?",
        "Pa lwai depi mo lakaz",
        "Bien pre depi isi",
        "Kapav marse pu ale"
      ]
    },
    {
      "title": "Koz lor bann lwazir",
      "img": "/images/hundredPhrases/talking_about_activities.webp",
      "alt": "Leisure Activities Image",
      "phrases": [
        "Ki to fer pu dister twa?",
        "Mo kontan danse",
        "Mo kontan vwayaze",
        "Mo kontan lamizik",
        "Ki kalite lamizik to kontan?",
        "Mo kontan preske tu kalite lamizik",
        "Mo kontan Diaaz",
        "Twa?",
        "Eski to kontan ispor?",
        "Wi, mo kontan",
        "Non, m opa kontan zwe tenis/ volebol/ pingpong/ futbol/eksetera"
      ]
    },
    {
      "title": "Fer kamarad/ bann ti koze",
      "img": "/images/hundredPhrases/makingFriends.webp",
      "alt": "Making Friends Image",
      "phrases": [
        "Eski to swaf?",
        "Ki to kontan bwar?",
        "Eski to oule kitsz pub war?",
        "Non, me mo finn?",
        "Mo tia kontan enn ti labyer, sil te ple.",
        "Enn tas kafe, sil te ple",
        "Kuma letan ti ete yer?",
        "Pa diferan depi zordi/ Ti ena soley yer/ Ti ena lapli tut lazurne",
        {
          "subtitle": "Pran enn taksi",
          "phrases": [
            "Eski sa taksi la lib?",
            "Wi, kot ou anvi ale?",
            "Lotel Sant Vil (Down Tawn)"
          ]
        }
      ]
    }
  ]
