# ============================================
# Mulingua Project - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Backend ---
VITE_BACKEND_URL=http://localhost:5000

# --- AI Chatbot ---
# Groq API key for AI chatbot responses
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Upstash Redis for IP rate limiting
# Get your keys at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# --- Voice Input ---
# Language for speech recognition (e.g., "en-US", "ar-SA", "es-ES")
VITE_CHATBOT_LANG=en-US

# --- Frontend ---
# Domain context for AI responses (general, teachers)
VITE_CHATBOT_DOMAIN=general

# --- Existing Variables ---
VITE_INTRO_VIDEO_EN=
VITE_INTRO_VIDEO_ES=
VITE_INTRO_VIDEO_FR=
VITE_PUBLIC_RECAPTCHA_SITE_KEY=
VITE_ABLY_API_KEY=
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_SECRET=
